<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>wps-watch-ai-reporting</UserSecretsId>
  </PropertyGroup>

  <!-- The Vite front-end source lives under ClientApp/ and builds into wwwroot/.
       Keep its sources (and node_modules) out of the .NET item globs so dotnet
       build / watch don't scan them. wwwroot (the build output) is served normally. -->
  <ItemGroup>
    <Content Remove="ClientApp\**" />
    <None Remove="ClientApp\**" />
    <Compile Remove="ClientApp\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wps.Watch.AiReporting.Data\Wps.Watch.AiReporting.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wps.Watch.AiReporting.Test" />
  </ItemGroup>

</Project>
